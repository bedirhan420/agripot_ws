<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    6-DOF hasat kolu iskeleti (MoveIt2 "agribot_arm" planning group ile eslesir,
    bkz. agribot_manipulation/planning/moveit2_adapter.py planning_group parametresi).
    Eklem limitleri ve link boyutlari YER TUTUCUDUR; gercek kinematik zincir
    MoveIt Setup Assistant ile kalibre edilmelidir.
  -->
  <xacro:macro name="agribot_arm" params="parent_link">
    <xacro:property name="link_len" value="0.25"/>

    <xacro:macro name="arm_link" params="name">
      <link name="${name}">
        <visual><geometry><cylinder radius="0.03" length="${link_len}"/></geometry></visual>
        <collision><geometry><cylinder radius="0.03" length="${link_len}"/></geometry></collision>
        <inertial><mass value="0.5"/><inertia ixx="1e-3" ixy="0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3"/></inertial>
      </link>
    </xacro:macro>

    <xacro:arm_link name="arm_link_1"/>
    <xacro:arm_link name="arm_link_2"/>
    <xacro:arm_link name="arm_link_3"/>
    <xacro:arm_link name="arm_link_4"/>
    <xacro:arm_link name="arm_link_5"/>
    <link name="end_effector_link"/>

    <joint name="arm_joint_1" type="revolute">
      <parent link="${parent_link}"/><child link="arm_link_1"/>
      <axis xyz="0 0 1"/><limit lower="-3.14" upper="3.14" effort="30" velocity="1.5"/>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
    </joint>
    <joint name="arm_joint_2" type="revolute">
      <parent link="arm_link_1"/><child link="arm_link_2"/>
      <axis xyz="0 1 0"/><limit lower="-1.57" upper="1.57" effort="30" velocity="1.5"/>
      <origin xyz="0 0 ${link_len}" rpy="0 0 0"/>
    </joint>
    <joint name="arm_joint_3" type="revolute">
      <parent link="arm_link_2"/><child link="arm_link_3"/>
      <axis xyz="0 1 0"/><limit lower="-2.0" upper="2.0" effort="20" velocity="1.5"/>
      <origin xyz="0 0 ${link_len}" rpy="0 0 0"/>
    </joint>
    <joint name="arm_joint_4" type="revolute">
      <parent link="arm_link_3"/><child link="arm_link_4"/>
      <axis xyz="1 0 0"/><limit lower="-3.14" upper="3.14" effort="10" velocity="2.0"/>
      <origin xyz="0 0 ${link_len}" rpy="0 0 0"/>
    </joint>
    <joint name="arm_joint_5" type="revolute">
      <parent link="arm_link_4"/><child link="arm_link_5"/>
      <axis xyz="0 1 0"/><limit lower="-1.57" upper="1.57" effort="10" velocity="2.0"/>
      <origin xyz="0 0 ${link_len}" rpy="0 0 0"/>
    </joint>
    <joint name="end_effector_joint" type="fixed">
      <parent link="arm_link_5"/><child link="end_effector_link"/>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
    </joint>

    <!-- Gazebo/ros2_control kuvvet-kontrolu icin gerekli arayuz. Force controller
         (agribot_manipulation/control/force_controller.py) bu eklemlere efor uygular. -->
    <ros2_control name="AgribotArmSystem" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>
      <xacro:macro name="effort_joint_interface" params="joint_name">
        <joint name="${joint_name}">
          <command_interface name="effort"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>
      </xacro:macro>
      <xacro:effort_joint_interface joint_name="arm_joint_1"/>
      <xacro:effort_joint_interface joint_name="arm_joint_2"/>
      <xacro:effort_joint_interface joint_name="arm_joint_3"/>
      <xacro:effort_joint_interface joint_name="arm_joint_4"/>
      <xacro:effort_joint_interface joint_name="arm_joint_5"/>
    </ros2_control>
  </xacro:macro>
</robot>
