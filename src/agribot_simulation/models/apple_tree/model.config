<?xml version="1.0"?>
<model>
  <name>apple_tree</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    Basit govde+canopy modeli (Blender'da detaylandirilacak). Elma modelleri
    (apple_fruit) bu agacin "branch_link" cercevesine spawner script'i
    ile eklenir; boylece agac ve meyve sayisi/dagilimi runtime'da
    (Python spawner uzerinden) kolayca degistirilebilir.
  </description>
</model>
