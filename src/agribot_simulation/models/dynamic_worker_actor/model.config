<?xml version="1.0"?>
<model>
  <name>dynamic_worker_actor</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    Gazebo native "actor" tabanli, onceden tanimli waypoint'ler arasinda
    dolasan bir tarla iscisi/insan modeli. dynamic_obstacle_spawner.py
    icindeki Factory bunu "actor" tipi engeller icin kullanir; alternatif
    olarak ayni script rastgele hareket eden basit collision-box'lar da
    uretebilir (kullanicinin projede belirttigi iki yontem de desteklenir).
  </description>
</model>
