<?xml version="1.0"?>
<model>
  <name>apple_fruit</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    "Kirilabilir eklem" (breakable joint) mekanizmasini gz-sim'in gercek
    DetachableJoint sistem eklentisi ile uygular: robot kol MoveIt2 ile
    meyveye ulasip yeterli Newton kuvvetini uyguladiginda, ROS2 tarafindaki
    breakable_joint_manager.py node'u bu modelin "detach" topic'ine bir
    mesaj yayinlar ve eklem calisirken (runtime) kopar.
  </description>
</model>
