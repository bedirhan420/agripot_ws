<?xml version="1.0"?>
<sdf version="1.9">
  <model name="apple_fruit">
    <!-- Baslangicta statik DEGIL: eklem koptugunda serbest dusme fizigi
         uygulanabilmesi icin dinamik govde olarak tanimlanir; agaca
         DetachableJoint ile "sabitlenir". -->
    <static>false</static>

    <link name="apple_link">
      <inertial>
        <mass>0.15</mass>
        <inertia><ixx>2e-4</ixx><iyy>2e-4</iyy><izz>2e-4</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="apple_visual">
        <geometry><sphere><radius>0.04</radius></sphere></geometry>
        <material><ambient>0.7 0.05 0.05 1</ambient><diffuse>0.7 0.05 0.05 1</diffuse></material>
      </visual>
      <collision name="apple_collision">
        <geometry><sphere><radius>0.04</radius></sphere></geometry>
      </collision>
    </link>

    <!--
      KIRILABILIR EKLEM MEKANIZMASI
      ------------------------------
      gz-sim'in yerlesik DetachableJoint sistemi, iki model arasindaki sabit
      baglantiyi calisirken (runtime), bir topic'e mesaj gelince koparir.
      Spawn sirasinda parent_link (agacin branch_link'i) spawner script'i
      tarafindan `<parent_link>` alanina yazilir (bkz.
      scripts/dynamic_obstacle_spawner.py'nin kardesi olan meyve spawn
      mantigi, agribot_simulation/scripts/fruit_spawner.py).

      Kuvvet esigi burada DEGIL, ROS2 tarafinda
      (agribot_manipulation/control/force_controller.py hedef kuvvete
      ulastiginda) izlenir; esik asilinca breakable_joint_manager.py
      asagidaki <topic> alanina bir std_msgs/Empty (ros_gz koprusu
      uzerinden gz.msgs.Empty) yayinlar.
    -->
    <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
      <parent_link>apple_link</parent_link>
      <child_model>apple_tree</child_model>
      <child_link>branch_link</child_link>
      <detach_topic>/agribot/harvest/detach_apple</detach_topic>
      <output_topic>/agribot/harvest/detach_status</output_topic>
    </plugin>
  </model>
</sdf>
