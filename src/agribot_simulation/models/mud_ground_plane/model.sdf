<?xml version="1.0"?>
<sdf version="1.9">
  <model name="mud_ground_plane">
    <static>true</static>
    <link name="patch_link">
      <collision name="collision">
        <geometry>
          <plane><normal>0 0 1</normal><size>4 4</size></plane>
        </geometry>
        <surface>
          <friction>
            <ode>
              <!--
                mu1/mu2: ODE Coulomb surtunme katsayilari.
                Kuru zemin icin ~0.8-0.9, camurlu/islak zemin icin ~0.15-0.35
                araligi gerceklestirmede kullanilabilir (deneysel olarak
                kalibre edilmelidir). Bu degerler runtime'da dogrudan
                degistirilemez (SDF statik); calisirken farkli surtunmeli
                yeni bir patch spawn edip robotun uzerinden gecmesi
                mud_friction_randomizer.py ile saglanir.
              -->
              <mu1>0.9</mu1>
              <mu2>0.9</mu2>
            </ode>
          </friction>
          <contact>
            <ode><kp>1e6</kp><kd>1.0</kd></ode>
          </contact>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><plane><normal>0 0 1</normal><size>4 4</size></plane></geometry>
        <material>
          <ambient>0.35 0.25 0.15 1</ambient>
          <diffuse>0.35 0.25 0.15 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
