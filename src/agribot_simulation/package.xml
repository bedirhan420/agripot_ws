<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>agribot_simulation</name>
  <version>0.1.0</version>
  <description>
    Gazebo (gz-sim) dunyalari, agac/meyve modelleri (kirilabilir eklem),
    dinamik engel uretimi ve MuJoCo alternatif sahnesi.
  </description>
  <maintainer email="dev@example.com">AgriBot Dev Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>agribot_core</depend>
  <depend>agribot_msgs</depend>
  <depend>ros_gz_sim</depend>
  <depend>ros_gz_bridge</depend>
  <depend>std_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
